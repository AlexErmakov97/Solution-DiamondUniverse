            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="76" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; «Аукцион» → «Логистика»:&lt;br&gt;задание на отгрузку (данные победителя,&lt;br&gt;ID камня, адрес доставки)&lt;br&gt;вручную (ввод логистом)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="72" target="45">
