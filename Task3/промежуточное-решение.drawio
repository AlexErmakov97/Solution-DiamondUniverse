        <mxCell id="42" value="&lt;b&gt;ИС «Алмазы»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, без доработок&lt;/i&gt;&lt;hr&gt;планирование работ&lt;br&gt;присвоение идентификаторов&lt;br&gt;подготовка ведомостей&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; статус камня «продан» (ввод вручную&lt;br&gt;по реестру победителей)&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер по отбору&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="90" width="280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; Реестр отбора и оцифровки&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel по утверждённому шаблону&lt;/i&gt;&lt;hr&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; отбор алмазов для цифрового аукциона&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; категоризация камней (готовность&lt;br&gt;для передачи на аукцион)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; планирование и отслеживание работ&lt;br&gt;по оцифровке&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; ведомость передачи камней в лабораторию&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер по отбору&lt;/i&gt;" style="shape=document;size=0.08;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="44" value="&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; ИС «Лаборатория»&lt;/b&gt;&lt;br&gt;&lt;i&gt;новая, внешний подрядчик&lt;/i&gt;&lt;hr&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; оцифровка алмазов (в соответствии&lt;br&gt;с требованиями экспертов)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; защищённая передача результатов&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: специалист лаборатории&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1530" y="90" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="45" value="&lt;b&gt;ИС «Логистика»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, без доработок&lt;/i&gt;&lt;hr&gt;перевозка алмазов покупателю по стране&lt;br&gt;и за границу&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; отправка алмазов в лабораторию&lt;br&gt;и возврат в офис (оформляется&lt;br&gt;как обычная перевозка)&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; отправка камней победителям по заданию&lt;br&gt;из реестра победителей&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: логист&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="46" value="&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; Реестр результатов оцифровки&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel по утверждённому шаблону&lt;/i&gt;&lt;hr&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; связь камня с цифровым представлением&lt;br&gt;(ID камня + ссылки на файлы в облаке)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; описание камней для аукциона&lt;br&gt;на английском языке&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер аукциона&lt;/i&gt;" style="shape=document;size=0.08;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1150" y="390" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="47" value="&lt;b&gt;ИС «Бухгалтерия»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, без доработок&lt;/i&gt;&lt;hr&gt;ведение контрактов&lt;br&gt;актирование и оплата услуг&lt;br&gt;компаний-перевозчиков&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; актирование и оплата услуг&lt;br&gt;лаборатории (ввод по акту вручную)&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: бухгалтер&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="690" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="48" value="&lt;b&gt;ИС «Аукцион»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, без доработок&lt;/i&gt;&lt;hr&gt;проведение аукциона (офлайн)&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; пилотные торги в штатном офлайн-режиме:&lt;br&gt;покупатели участвуют по видеосвязи,&lt;br&gt;менеджер вносит их ставки в ИС&lt;br&gt;и фиксирует победителя&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; ссылка на данные лота в облаке —&lt;br&gt;в существующем поле описания лота&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; выгрузка итогов торгов&lt;br&gt;в реестр победителей&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер аукциона&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1150" y="690" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="49" value="&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; Облачный провайдер&lt;/b&gt;&lt;br&gt;&lt;i&gt;новый внешний сервис,&lt;br&gt;только промежуточное решение&lt;/i&gt;&lt;hr&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; хранение данных оцифровки&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; публикация данных о камнях&lt;br&gt;для клиентов (на английском)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; разграничение доступа покупателей&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер провайдера&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
