        <mxCell id="75" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; итоги торгов: победитель,&lt;br&gt;ID купленного камня, цена&lt;br&gt;вручную (выгрузка менеджером)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="48" target="72">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="910" y="898" />
