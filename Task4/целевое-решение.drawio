  <diagram name="Страница-1" id="Na4_whWbAbaNYMotCna3">
    <mxGraphModel dx="3491" dy="2257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3dz7YyW7NIAcRIE6oamp-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;arcSize=2;" value="&lt;b&gt;Контур «Diamond Universe» (серверы компании)&lt;/b&gt;" vertex="1">
          <mxGeometry height="1390" width="1420" x="290" y="230" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-3" parent="1" style="text;html=1;fontSize=13;align=left;" value="&lt;b&gt;Внешние системы&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="300" x="1790" y="600" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; ИС «Алмазы»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, дорабатывается&lt;/i&gt;&lt;hr&gt;планирование работ&lt;br&gt;присвоение идентификаторов&lt;br&gt;подготовка ведомостей&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; отбор алмазов для цифрового аукциона&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; категоризация камней (готовность&lt;br&gt;для передачи на аукцион)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; планирование и отслеживание работ&lt;br&gt;по оцифровке, статусы камня&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; ведомости для передачи в лабораторию&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; связь камня с цифровым представлением&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; статус «продан» по итогам торгов&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер по отбору&lt;/i&gt;" vertex="1">
          <mxGeometry height="290" width="320" x="310" y="280" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; ИС «Аукцион»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, дорабатывается&lt;/i&gt;&lt;hr&gt;проведение аукциона (офлайн)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; проведение аукциона (онлайн)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; регистрация покупателей&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; загрузка и хранение цифрового описания&lt;br&gt;камней (на серверах компании)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; публикация данных о камнях для клиентов,&lt;br&gt;отображение лотов&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; многоязычность: интерфейс, карточки лотов,&lt;br&gt;условия торгов (EN, RU; расширяемо)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; онлайн-ставки&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; регистрация покупки&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; передача итогов торгов&lt;br&gt;в «Логистику» и «Алмазы»&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; обеспечение сохранности данных&lt;br&gt;покупателей и лотов&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; ввод ставок удалённых покупателей&lt;br&gt;менеджером (пилот)&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: менеджер аукциона&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="340" x="1350" y="280" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; ИС «Логистика»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, дорабатывается&lt;/i&gt;&lt;hr&gt;перевозка алмазов покупателю по стране&lt;br&gt;и за границу&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; отправка алмазов в лабораторию&lt;br&gt;и возврат в офис после оцифровки&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; маршрут офис → лаборатория → офис&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; задание на отгрузку победителю&lt;br&gt;из ИС «Аукцион»&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: логист&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="310" y="690" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; ИС «Бухгалтерия»&lt;/b&gt;&lt;br&gt;&lt;i&gt;существующая, дорабатывается&lt;/i&gt;&lt;hr&gt;ведение контрактов&lt;br&gt;актирование и оплата услуг&lt;br&gt;компаний-перевозчиков&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; актирование и оплата услуг лаборатории&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; новый вид счёт-фактуры для лаборатории&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: бухгалтер&lt;/i&gt;" vertex="1">
          <mxGeometry height="210" width="320" x="310" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=44;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" value="&lt;b&gt;ИС «Лаборатория»&lt;/b&gt;&lt;br&gt;&lt;i&gt;внешний подрядчик, сохраняется&lt;/i&gt;&lt;hr&gt;оцифровка алмазов (в соответствии&lt;br&gt;с требованиями экспертов)&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; автоматическая передача результатов&lt;br&gt;по защищённому каналу&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; автоматическая передача актов&lt;br&gt;&lt;br&gt;&lt;i&gt;Роль: специалист лаборатории&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="300" x="1790" y="690" as="geometry" />
        </mxCell>
