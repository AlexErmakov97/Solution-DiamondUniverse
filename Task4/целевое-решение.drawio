        <mxCell id="3dz7YyW7NIAcRIE6oamp-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff5f5;strokeColor=#C62828;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;arcSize=3;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Выводится из эксплуатации (было в промежуточном решении)&lt;/b&gt;" vertex="1">
          <mxGeometry height="560" width="1000" x="690" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Облачный провайдер&lt;/b&gt;&lt;br&gt;&lt;i&gt;внешний сервис&lt;/i&gt;&lt;hr&gt;хранение данных оцифровки&lt;br&gt;публикация данных для клиентов&lt;br&gt;→ переносится в ИС «Аукцион»" vertex="1">
          <mxGeometry height="140" width="228" x="710" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Реестр отбора и оцифровки&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel&lt;/i&gt;&lt;hr&gt;отбор, категоризация,&lt;br&gt;план оцифровки, ведомости&lt;br&gt;→ переносится в ИС «Алмазы»" vertex="1">
          <mxGeometry height="140" width="228" x="953" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Реестр результатов оцифровки&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel&lt;/i&gt;&lt;hr&gt;ID камня + ссылки на файлы&lt;br&gt;→ автоматическая интеграция&lt;br&gt;«Лаборатория» → «Аукцион»" vertex="1">
          <mxGeometry height="140" width="228" x="1196" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Акт услуг лаборатории&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel&lt;/i&gt;&lt;hr&gt;акт, счёт-фактура&lt;br&gt;→ автоматическая интеграция&lt;br&gt;«Лаборатория» → «Бухгалтерия»" vertex="1">
          <mxGeometry height="140" width="228" x="1439" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Выводимые ручные интеграции&lt;/b&gt;&lt;br&gt;• «Алмазы» → Excel-реестр → «Лаборатория» (ID камней, ведомость)&lt;br&gt;• «Алмазы» → Excel-реестр → «Аукцион» (состав лотов, ID)&lt;br&gt;• «Лаборатория» → Excel-реестр → «Аукцион» (описание камней, ссылки на облако)&lt;br&gt;• Excel-реестр → облачный провайдер (публикация файлов оцифровки сотрудниками)&lt;br&gt;• «Лаборатория» → Excel-акт → «Бухгалтерия» (акт, счёт-фактура, ввод бухгалтером)&lt;br&gt;• сервис видеосвязи → «Аукцион» (ставки покупателей, ввод менеджером)&lt;br&gt;• «Аукцион» → реестр победителей → «Логистика» (задание на отгрузку)&lt;br&gt;• «Аукцион» → реестр победителей → «Алмазы» (статус «продан»)" vertex="1">
          <mxGeometry height="200" width="960" x="710" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-22" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.27;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-5" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; состав лотов, ID камней&lt;br&gt;автоматически">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-23" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-8" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; ID камней, ведомость передачи&lt;br&gt;автоматически, защищённый канал">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1030" y="512" /><mxPoint x="1030" y="750" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-24" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-5" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; описание камней, файлы оцифровки&lt;br&gt;(сканы, УФ-снимки, характеристики)&lt;br&gt;автоматически, защищённый канал">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1940" y="672" /><mxPoint x="1622" y="672" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-25" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-7" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; акт выполненных работ, счёт-фактура&lt;br&gt;автоматически, защищённый канал">
