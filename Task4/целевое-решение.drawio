        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-26" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-6" value="&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; документы о перевозке, в т.ч.&lt;br&gt;в лабораторию и обратно (новые данные)&lt;br&gt;автоматически (существующая)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-27" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="3dz7YyW7NIAcRIE6oamp-7" value="данные оплаты услуг перевозчика&lt;br&gt;автоматически (существующая)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; новое (система, функция, интеграция)&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;⚑&lt;/b&gt;&lt;/font&gt; изменяемое&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; выводимое&lt;br&gt;───── автоматическая интеграция&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; внутренняя ИС &amp;nbsp;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; внешняя система&lt;br&gt;Стрелка: от инициатора к вызываемой системе&lt;br&gt;Точка отсчёта: промежуточное решение" vertex="1">
          <mxGeometry height="170" width="300" x="1790" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="3dz7YyW7NIAcRIE6oamp-29" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Допущения&lt;/b&gt;&lt;hr&gt;• все интеграции автоматические,&lt;br&gt;Excel не используется&lt;br&gt;• конфиденциальные данные передаются&lt;br&gt;по выделенным защищённым каналам&lt;br&gt;• данные оцифровки хранятся на серверах&lt;br&gt;компании в ИС «Аукцион»&lt;br&gt;• план и статусы подготовки аукциона&lt;br&gt;отслеживаются в ИС «Алмазы»&lt;br&gt;• язык по умолчанию — английский,&lt;br&gt;русский и другие языки покупателей&lt;br&gt;подключаются в ИС «Аукцион»" vertex="1">
          <mxGeometry height="240" width="300" x="1790" y="1220" as="geometry" />
        </mxCell>
      <mxCell id="e_auc_alm" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; ID купленного камня, статус «продан»&lt;br&gt;автоматически" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.42;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-5" target="3dz7YyW7NIAcRIE6oamp-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_auc_log" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;✚&lt;/b&gt;&lt;/font&gt; задание на отгрузку: данные победителя,&lt;br&gt;ID купленного камня, адрес доставки&lt;br&gt;автоматически" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3dz7YyW7NIAcRIE6oamp-5" target="3dz7YyW7NIAcRIE6oamp-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="622" /><mxPoint x="700" y="810" /></Array></mxGeometry></mxCell><mxCell id="rm_vks" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Сервис видеосвязи&lt;/b&gt;&lt;br&gt;&lt;i&gt;внешний сервис&lt;/i&gt;&lt;hr&gt;трансляция торгов, приём ставок&lt;br&gt;→ онлайн-ставки в ИС «Аукцион»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="710" y="1215" width="228" height="140" as="geometry" /></mxCell><mxCell id="rm_win" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;✖&lt;/b&gt;&lt;/font&gt; Реестр победителей&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel&lt;/i&gt;&lt;hr&gt;победитель, ID камня, адрес&lt;br&gt;→ автоматические интеграции&lt;br&gt;«Аукцион» → «Логистика», «Алмазы»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#C62828;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="953" y="1215" width="228" height="140" as="geometry" /></mxCell></root>
